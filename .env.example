# Before You Send — environment variables (names only; safe placeholders).
# Copy to .env and fill in real values. NEVER commit the real .env.

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- AI provider (SambaNova) ---
SAMBANOVA_API_KEY=change_me
LLM_API_KEY=change_me
LLM_BASE_URL=https://api.sambanova.ai/v1
LLM_MODEL=DeepSeek-V3.2
OPENAI_API_KEY=change_me
ALLOW_DEV_FALLBACK=false

# --- Auth / session ---
AUTH_SECRET=change_me
OWNER_EMAIL=change_me

# --- Email (optional) ---
EMAIL_API_KEY=change_me
EMAIL_FROM=Before You Send <noreply@example.com>

# --- Stripe (owner's own account keys live in the deployment env, never in the repo) ---
STRIPE_SECRET_KEY=change_me
STRIPE_WEBHOOK_SECRET=change_me

# --- Vercel deploy token (CI) ---
VERCEL_TOKEN=change_me

# --- TikTok ---
TIKTOK_CLIENT_KEY=change_me
TIKTOK_CLIENT_SECRET=change_me
TIKTOK_ACCESS_TOKEN=change_me
TIKTOK_PIXEL_ID=change_me

# --- Google Ads ---
GOOGLE_ADS_ID=AW-00000000000

# --- Rate / concurrency caps ---
ANON_IP_DAILY_CAP=10
MAX_CONCURRENT_REVIEWS=4
MAX_ORGANIZER_CLASSIFY=20
ORGANIZER_TRIAL_IP_DAILY_CAP=3

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Pricing (USD cents; halved ladder 2026-08-11) ---
PRICE_STEADY_USD_CENTS=499
PRICE_COMMAND_USD_CENTS=1249
PRICE_ULTIMATE_USD_CENTS=2499
PRICE_ULTIMATE_INTRO_USD_CENTS=1999
PRICE_STEADY_ANNUAL_USD_CENTS=4990
PRICE_COMMAND_ANNUAL_USD_CENTS=12490
PRICE_ULTIMATE_ANNUAL_USD_CENTS=24990
PRICE_CONSULTATION_USD_CENTS=3950
PRICE_REVIEW_TOPUP_USD_CENTS=950
PRICE_GIFT_MONTH_USD_CENTS=499
PRICE_SORTPILE_USD_CENTS=1950
PRICE_SUBSCRIPTION_USD_CENTS=499
VITE_PRICE_CONSULTATION_USD_CENTS=3950

# --- Client (Vite, baked at build time) ---
VITE_GOOGLE_ADS_ID=AW-00000000000
VITE_GOOGLE_CV_EMAIL=change_me
VITE_GOOGLE_CV_ACCOUNT=change_me
VITE_GOOGLE_CV_REVIEW=change_me
VITE_GOOGLE_CV_CHECKOUT=change_me
VITE_GOOGLE_CV_SUBSCRIPTION=change_me
VITE_CHECKIN_PCT=80
